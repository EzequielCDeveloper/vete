# ─── VetCare — Variables de Entorno ──────────────────────────
# Copia este archivo como .env y completá los valores.
#   cp backend/.env.example backend/.env
#
# ⚠️  NUNCA committees el .env real. El .gitignore ya lo excluye.
# ─────────────────────────────────────────────────────────────

# ─── Servidor ────────────────────────────────────────────────
PORT=4000

# ─── JWT ─────────────────────────────────────────────────────
# 🔴 OBLIGATORIO — el server NO arranca sin esto.
# Generalo con: openssl rand -base64 64
# En desarrollo copiá este de ejemplo, en produccion genera uno nuevo.
JWT_SECRET=GeUsmpYVVkVtZsVRq6/xYerJKKBcU+VKDUf8JHK5r7k=

# ─── CORS ────────────────────────────────────────────────────
# Origen permitido para CORS. En desarrollo podés usar "*".
# En producción: https://tudominio.com
# Si no se setea y NODE_ENV=production, CORS bloquea todo origen externo.
CORS_ORIGIN=*

# ─── Entorno ─────────────────────────────────────────────────
# production | development
# En production: CORS se vuelve estricto, helmet aplica defaults seguros.
NODE_ENV=development

# ─── Base de Datos (MariaDB) ─────────────────────────────────
# Socket de conexión (conexión local por socket)
DB_SOCKET=/tmp/mariadb-vet.sock
# Usuario — en produccion NO usar root, crear usuario dedicado
DB_USER=root
# Contraseña — en produccion poner una contraseña fuerte
DB_PASS=
# Nombre de la base de datos
DB_NAME=Veterinaria_pet_land
